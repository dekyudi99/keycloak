# ==============================================================================
# WEFGIS Keycloak Service Environment Configuration Template
# ==============================================================================
# Salin file ini menjadi .env dan sesuaikan nilainya:
# cp .env.example .env

# Network & Host Binding
DB_BIND_IP=127.0.0.1
KEYCLOAK_HOSTNAME=http://localhost:8081
KEYCLOAK_HTTP_PORT=8081

# Database Configuration (PostGIS)
KEYCLOAK_DB_USER=keycloak_svc
KEYCLOAK_DB_PASSWORD=change_this_to_a_secure_db_password
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_HOST=keycloak-db
KEYCLOAK_DB_INTERNAL_PORT=5432
KEYCLOAK_DB_PORT=5433

# Keycloak Bootstrap Administrator
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=change_this_to_a_secure_admin_password
